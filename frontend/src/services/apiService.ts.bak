      ...getAuthHeaders(),
    },
    credentials: 'include',
    body: JSON.stringify({
      confirmation: true,
      password: password || undefined,
      reason: reason || undefined,
    }),
  });
  const data = await response.json();
  if (!response.ok) {
    throw new Error(data?.detail?.message || data?.message || 'Failed to disable account');
  }
  return data;
};

