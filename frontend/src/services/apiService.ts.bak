export const getAdminSecurityLogsApi = async (severity?: string, eventType?: string, search?: string, limit = 50, offset = 0) => {
  const queryParams = new URLSearchParams();
  if (severity) queryParams.append('severity', severity);
  if (eventType) queryParams.append('event_type', eventType);
  if (search) queryParams.append('search', search);
  queryParams.append('limit', limit.toString());
  queryParams.append('offset', offset.toString());

  const response = await fetch(`${API_BASE_URL}/admin/security/logs?${queryParams.toString()}`, {
    method: 'GET',
    headers: { 'Content-Type': 'application/json' },
    credentials: 'include',
  });
  if (!response.ok) {
    throw new Error('Failed to fetch admin security logs');
  }
  return await response.json();
};

export const getAdminLogsApi = async () => {
  return getAdminSecurityLogsApi();
};

export const getCaptchaStatusApi = async (email?: string) => {
  const url = email ? `${API_BASE_URL}/captcha/status?email=${encodeURIComponent(email)}` : `${API_BASE_URL}/captcha/status`;
  const response = await fetch(url, {
    method: 'GET',
    headers: { 'Content-Type': 'application/json' },
    credentials: 'include',
  });
  if (!response.ok) return { captcha_required: false, risk_score: 0 };
  return await response.json();
};

