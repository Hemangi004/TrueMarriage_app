/** Permanently deletes the logged-in user's own biodata profile. Irreversible. */
export const deleteMyProfileApi = async (
  reason?: string,
  feedback?: string
): Promise<{ success: boolean; message: string }> => {
  const headers: Record<string, string> = {
    ...getAuthHeaders(),
  };
  const bodyData: Record<string, string> = {};
  if (reason) bodyData.reason = reason;
  if (feedback) bodyData.feedback = feedback;

  const hasBody = Object.keys(bodyData).length > 0;
  if (hasBody) {
    headers['Content-Type'] = 'application/json';
  }

  const res = await fetch(`${API_BASE_URL}/v1/biodata/me`, {
    method: 'DELETE',
    headers,
    credentials: 'include',
    body: hasBody ? JSON.stringify(bodyData) : undefined,
  });
  const data = await safeParseJson(res);
  if (!res.ok) {
    throw new Error(extractErrorMessage(data, 'Failed to delete profile'));
  }
  return data;
};
