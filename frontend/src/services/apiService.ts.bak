export const generateOllamaSummaryApi = async (
  userData: Partial<import('../types/biodata').BiodataForm>,
  model = 'llama3',
  previousBio?: string,
  tone = 'warm_balanced'
) => {
  try {
    const response = await fetch(`${API_BASE_URL}/ai/generate`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ type: 'ollama_summary', useOllama: true, userData, model, previousBio, tone }),
    });
    if (!response.ok) throw new Error('Ollama API failed');
    return await response.json();
  } catch {
    // Full offline fallback: build locally from formData in natural human voice matching tone (max 3 lines, ~30–45 words)
    const name = userData?.name || 'Aarav';
    const occ = userData?.occupation || 'Software Professional';
    const comp = userData?.company ? `at ${userData.company}` : '';
    const hobbies = (userData?.hobbies || []).slice(0, 2).join(', ') || 'reading and traveling';

    const localFallbacks: Record<string, string> = {
      warm_balanced: `Hi, I'm ${name}. I work as a ${occ} ${comp} and enjoy ${hobbies} during my free time. Raised with close family values, I look forward to building a happy, balanced life together.`,
      modern_professional: `Hello, I'm ${name}. Working as a ${occ} ${comp}, I'm driven by ambition and continuous growth. Outside work, I enjoy ${hobbies} and value an equal partnership built on mutual respect.`,
      traditional_cultural: `Hi, I'm ${name}. Blessed with strong family roots and cultural values, I work as a ${occ} ${comp}. In my free time, I enjoy ${hobbies}. I look forward to building a happy family together.`,
      heartfelt_direct: `Hi, I'm ${name}. Good conversations, ${hobbies}, and honest connections make me happiest. While I work as a ${occ} ${comp}, I value warmth and openness above all. Hoping for a genuine connection.`
    };

    const summary = localFallbacks[tone] || localFallbacks.warm_balanced;
    return { success: true, source: 'local_fallback', tone, summary, suggestions: [summary] };
  }
};

export const publishBiodataApi = async (formData: BiodataForm) => {
  const response = await fetch(`${API_BASE_URL}/biodata/publish`, {
    method: 'POST',
    headers: getAuthHeaders(),
    credentials: 'include',
    body: JSON.stringify(formData),
  });
  const resData = await safeParseJson(response);
  if (!response.ok) {
    const errorDetail = extractErrorMessage(resData, 'Failed to publish profile');
    throw new Error(errorDetail);
  }
  return resData;
};

