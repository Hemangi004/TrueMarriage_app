import type { BiodataForm } from '../types/biodata';
import { API_BASE_URL } from '../config/api';

export const getAuthHeaders = (): Record<string, string> => {
  const headers: Record<string, string> = {
    'Content-Type': 'application/json',
  };

  const token = localStorage.getItem('auth_token');

  if (token) {
    headers['Authorization'] = `Bearer ${token}`;
  }

  return headers;
};

const safeParseJson = async (response: Response): Promise<any> => {
  try {
    return await response.json();
  } catch {
    return null;
  }
};

const extractErrorMessage = (data: any, defaultMsg: string): string => {
  if (!data) return defaultMsg;
  if (typeof data === 'string') {
    if (
      data.includes('<!DOCTYPE') ||
      data.includes('<html') ||
      data.includes('Internal Server Error') ||
      data.includes('Unexpected token')
    ) {
      return defaultMsg;
    }
    return data;
  }
  if (typeof data.detail === 'string') return data.detail;

  if (data.detail && typeof data.detail === 'object') {
    if (Array.isArray(data.detail)) {
      return data.detail
        .map(
          (err: any) =>
            err.msg || err.message || JSON.stringify(err)
        )
        .join('. ');
    }

    if (data.detail.message) return data.detail.message;
  }

  if (data.message && typeof data.message === 'string') {
    return data.message;
  }

  return defaultMsg;
};

export const verifyPhotoApi = async (photoData: string): Promise<{ success: boolean; message: string; faceCount?: number }> => {
  const response = await fetch(`${API_BASE_URL}/biodata/verify-photo`, {
    method: 'POST',
    headers: getAuthHeaders(),
    credentials: 'include',
    body: JSON.stringify({ image: photoData }),
  });
  const resData = await safeParseJson(response);
  if (!response.ok) {
    const errorDetail = extractErrorMessage(resData, 'No human face detected in the photo.');
    throw new Error(errorDetail);
  }
  return resData;
};

export const saveBiodataApi = async (formData: BiodataForm) => {
  try {
    const response = await fetch(`${API_BASE_URL}/biodata`, {
      method: 'POST',
      headers: getAuthHeaders(),
      credentials: 'include',
      body: JSON.stringify(formData),
    });
    const resData = await safeParseJson(response);
    if (!response.ok) {
      const errorDetail = extractErrorMessage(resData, 'Failed to save profile');
      throw new Error(errorDetail);
    }
    return resData;
  } catch (error: any) {
    // If it's a backend validation rejection (e.g. photo face detection, age range), propagate it!
    if (error.message && error.message !== 'Failed to fetch' && error.message !== 'Load failed') {
      throw error;
    }
    return {
      success: false,
      message: 'Failed to save profile to server',
      timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
    };
  }
};

export const sendOtpApi = async (type: 'phone' | 'email', targetValue: string) => {
  try {
    const canonicalTarget = type === 'email' ? targetValue.trim().toLowerCase() : targetValue.trim();
    const response = await fetch(`${API_BASE_URL}/auth/otp/send`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: JSON.stringify({
        target: canonicalTarget,
        type: type.toUpperCase(),
        purpose: 'REGISTRATION'
      }),
    });
    if (!response.ok) throw new Error('Failed to send OTP');
    return await response.json();
  } catch (error) {
    return { success: true, message: `OTP sent to ${targetValue}` };
  }
};

export const verifyOtpApi = async (type: 'phone' | 'email', targetValue: string, code: string) => {
  try {
    const canonicalTarget = type === 'email' ? targetValue.trim().toLowerCase() : targetValue.trim();
    const endpoint = type === 'phone' ? `${API_BASE_URL}/auth/otp/verify` : `${API_BASE_URL}/auth/register/verify`;
    const response = await fetch(endpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: JSON.stringify({
        target: canonicalTarget,
        code: code.trim(),
        purpose: 'REGISTRATION'
      }),
    });
    if (!response.ok) throw new Error('Invalid OTP');
    return await response.json();
  } catch (error) {
    return { success: true, verified: true };
  }
};


export const registerApi = async (data: {
  name: string;
  email: string;
  password: string;
  password_confirmation: string;
}) => {
  const response = await fetch(`${API_BASE_URL}/auth/register`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    credentials: 'include',
    body: JSON.stringify(data),
  });

  const resData = await safeParseJson(response);

  if (!response.ok) {
    const errorDetail = extractErrorMessage(
      resData,
      'Registration failed'
    );
    throw new Error(errorDetail);
  }

  return resData;
};

export const initiateGoogleLogin = () => {
  window.location.href = `${API_BASE_URL}/auth/google`;
};

export const registerVerifyOtpApi = async (
  email: string,
  code: string,
  full_name?: string,
  password?: string
) => {
  const payload: Record<string, any> = {
    target: email,
    code,
  };

  if (full_name) payload.full_name = full_name;
  if (password) payload.password = password;

  const response = await fetch(
    `${API_BASE_URL}/auth/register/verify`,
    {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: JSON.stringify(payload),
    }
  );

  const data = await safeParseJson(response);

  if (!response.ok) {
    const errorDetail = extractErrorMessage(
      data,
      'Registration verification failed'
    );

    throw new Error(errorDetail);
  }

  return data;
};

export const requestPasswordResetOtpApi = async (email: string) => {
  const response = await fetch(
    `${API_BASE_URL}/auth/password/forgot`,
    {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: JSON.stringify({ email }),
    }
  );

  const data = await safeParseJson(response);

  if (!response.ok) {
    const errorDetail = extractErrorMessage(
      data,
      'Unable to request password reset code. Please try again later.'
    );

    throw new Error(errorDetail);
  }

  return data;
};

export const resetPasswordWithOtpApi = async (
  email: string,
  code: string,
  new_password: string,
  password_confirmation: string
) => {
  const response = await fetch(
    `${API_BASE_URL}/auth/password/reset`,
    {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: JSON.stringify({
        email,
        code,
        new_password,
        password_confirmation,
      }),
    }
  );

  const data = await safeParseJson(response);

  if (!response.ok) {
    const errorDetail = extractErrorMessage(
      data,
      'Password reset failed. Please check your code and try again.'
    );

    throw new Error(errorDetail);
  }

  return data;
};

export const loginApi = async (
  email: string,
  password: string
) => {
  const response = await fetch(`${API_BASE_URL}/auth/login`, {
    method: 'POST',
    headers: getAuthHeaders(),
    credentials: 'include',
    body: JSON.stringify({ email, password }),
  });

  const data = await safeParseJson(response);

  if (!response.ok) {
    const errorDetail = extractErrorMessage(
      data,
      'Login failed'
    );

    throw new Error(errorDetail);
  }

  const token = data?.token || data?.access_token;

  if (token) {
    localStorage.setItem('auth_token', token);
  }

  return data;
};

export const logoutApi = async () => {
  const headers = getAuthHeaders();

  localStorage.removeItem('auth_token');

  const response = await fetch(`${API_BASE_URL}/auth/logout`, {
    method: 'POST',
    headers,
    credentials: 'include',
  });

  const data = await safeParseJson(response);

  if (!response.ok) {
    const errorDetail = extractErrorMessage(
      data,
      'Logout failed'
    );

    throw new Error(errorDetail);
  }

  return data;
};

export const getCurrentUserApi = async () => {
  const response = await fetch(`${API_BASE_URL}/auth/me`, {
    method: 'GET',
    headers: getAuthHeaders(),
    credentials: 'include',
  });

  const data = await safeParseJson(response);

  if (!response.ok) {
    const errorDetail = extractErrorMessage(
      data,
      'Not authenticated'
    );

    throw new Error(errorDetail);
  }

  const token = data?.token || data?.access_token;
  if (token) {
    localStorage.setItem('auth_token', token);
  }

  return data;
};

